<?xml version="1.0" encoding="utf-8"?>
<!--
  LatvianTube — base (Latvian) strings.

  Latvian is the DEFAULT locale here, not a translation overlay. That inverts the
  usual Android arrangement on purpose: the app's audience is Latvian-speaking,
  and treating Latvian as the base means a missing string falls back to Latvian
  rather than to English.

  This is a direct response to a defect found in SmartTube (see ANALYSIS.md,
  evidence group E6): Latvian there is only ~120 of 748 base strings, so roughly
  84% of its UI silently falls back to English even when the device is set to
  Latvian. There is no completeness check, so the shortfall is invisible.
-->
<resources>

    <string name="app_name" translatable="false">LatvianTube</string>
    <string name="browse_title">LatvianTube</string>

    <!-- Browse rows -->
    <string name="row_empty_filtered">nav latviešu video</string>

    <!-- Search -->
